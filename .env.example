# Copy this file:  cp .env.example .env   (optional - these are the defaults)

# Where Ollama is running
OLLAMA_BASE_URL=http://localhost:11434

# Model used by the app we are testing (any model from `ollama list`)
LLM_MODEL=gemma3:4b

# Model used as the "judge" that grades answers in DeepEval.
JUDGE_MODEL=gemma3:4b
